# Server Port Configuration
PORT=3040

# Komal AI API Base URL (if custom, defaults to https://komal-api.habuild.in)
KOMAL_API_URL=https://komal-api.habuild.in

# Google API Credentials Configurations
# You can either provide Google credentials file path or stringified JSON directly
GOOGLE_CREDENTIALS_FILE=google-credentials.json
# GOOGLE_CREDENTIALS_JSON='{"type": "service_account", ...}'

# Google Drive and Spreadsheet Configuration
DRIVE_STATE_FOLDER_ID=
SPREADSHEET_ID=

# Email (SMTP) Configuration (Defaults to simulation mode if not set)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Habuild OJT System" <noreply@habuild.in>

# Twilio (WhatsApp) Configuration (Defaults to simulation mode if not set)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
